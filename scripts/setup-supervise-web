#!/usr/bin/env python3
"""Install local web dependencies into an isolated repository environment."""
from pathlib import Path
import subprocess
import sys
import venv

root = Path(__file__).resolve().parent.parent
env = root / '.agent-loop' / 'web-venv'
venv.EnvBuilder(with_pip=True).create(env)
subprocess.run([str(env / 'bin' / 'python'), '-m', 'pip', 'install', '-r', str(root / 'requirements-web.txt')], check=True)
subprocess.run(['npm', 'ci', '--prefix', str(root / 'web')], check=True)
print('Ready. Run scripts/supervise-web and open http://127.0.0.1:8765')
