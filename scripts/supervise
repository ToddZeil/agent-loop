#!/usr/bin/env python3
"""Run the repository's supervisor CLI from any current directory."""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from loop.__main__ import main

sys.argv.insert(1, 'supervise')
try:
    raise SystemExit(main())
except KeyboardInterrupt:
    print('Stopped. Worker progress is saved; use supervise resume to reconcile it.')
    raise SystemExit(130)
